FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OCR_MODE=tesseract \
    PORT=10000

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-ara tesseract-ocr-eng fonts-noto-core \
    libraqm0 libharfbuzz0b libfribidi0 libgomp1 libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-free.txt ./
RUN pip install --upgrade pip && pip install -r requirements-free.txt
# main.py imports local service modules at startup; include every one in the runtime image.
COPY main.py pdf_tools.py searchable_pdf.py redaction.py document_export.py pdf_security.py pdf_to_docx.py pdf_image_tools.py request_limits.py office_conversion.py pdf_compare.py document_layout.py text_style.py image_cleanup.py ./

EXPOSE 10000
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-10000}"]
