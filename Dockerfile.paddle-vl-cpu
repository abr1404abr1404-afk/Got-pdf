FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 libsm6 libxext6 libxrender1 fonts-noto-core ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /worker
RUN python -m pip install --upgrade pip && python -m pip install paddlepaddle==3.2.1 -i https://www.paddlepaddle.org.cn/packages/stable/cpu/ && python -m pip install "paddleocr[doc-parser]>=3.3.2,<4" && paddlex --install serving
EXPOSE 8080
CMD ["paddlex", "--serve", "--pipeline", "PaddleOCR-VL", "--device", "cpu", "--host", "0.0.0.0", "--port", "8080"]
